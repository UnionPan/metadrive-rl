+_PLACEHOLDER_CACHE: dict[tuple[tuple[int, int], int], bytes] = {}
+
+
+def _placeholder_image(resolution_hw: tuple[int, int], image_format: ImageFormat) -> bytes:
+    """Encode a black frame of the camera's resolution for skip-mode rendering."""
+    key = (tuple(resolution_hw), int(image_format))
+    if key not in _PLACEHOLDER_CACHE:
+        height, width = resolution_hw
+        buffer = BytesIO()
+        Image.new("RGB", (width, height)).save(
+            buffer, format="PNG" if image_format == ImageFormat.PNG else "JPEG"
+        )
+        _PLACEHOLDER_CACHE[key] = buffer.getvalue()
+    return _PLACEHOLDER_CACHE[key]
+
