+def _layer_split_device_map(n_gpus: int, n_layers: int = 64) -> dict[str, int]:
+    """Split the VLM and the trajectory expert at the same layer indices.
+
+    The expert's layer ``i`` attends to the KV cache written by VLM layer ``i``,
+    so both must share a GPU; a generic balanced map splits them differently and
+    the denoising step fails on cross-device tensors.
+    """
+    per_gpu = -(-n_layers // n_gpus)
+    last = n_gpus - 1
+    device_map: dict[str, int] = {
+        "vlm.model.visual": 0,
+        "vlm.model.language_model.embed_tokens": 0,
+        # Weightless modules (rotary inv_freq buffers) would otherwise stay on CPU.
+        "vlm.model.language_model.rotary_emb": 0,
+        "expert.expert.rotary_emb": 0,
+        "vlm.model.language_model.norm": last,
+        "vlm.lm_head": last,
+        "expert.action_in_proj": 0,
+        "expert.action_space": 0,
+        # The denoising loop adds the expert's output to noise created on GPU 0.
+        "expert.expert.norm": 0,
+        "expert.action_out_proj": 0,
+    }
+    for i in range(n_layers):
+        device_map[f"vlm.model.language_model.layers.{i}"] = i // per_gpu
+        device_map[f"expert.expert.layers.{i}"] = i // per_gpu
+    return device_map
+
+
